# Frontend build settings (Vite). Copy to frontend/.env.production (git-ignored).
# Values are baked into the bundle at build time: rebuild after every change.
# Most of these come from the stack outputs after the first deploy (see README, "Deploy").

# API Gateway URL from the stack output APIEndpoint, without the trailing slash.
VITE_API_BASE_URL=https://abc123.execute-api.eu-west-1.amazonaws.com/prod

# Rendition CDN from the stack output RenditionCdnURL (serves /derived/*).
VITE_RENDITION_BASE_URL=https://d111111abcdef8.cloudfront.net

# Cognito (same values as lawt.env).
VITE_COGNITO_USER_POOL_ID=eu-west-1_AbCdEfGhI
VITE_COGNITO_USER_POOL_CLIENT_ID=exampleclientid1234567890ab
VITE_COGNITO_REGION=eu-west-1
VITE_COGNITO_HOSTED_UI_DOMAIN=my-prefix.auth.eu-west-1.amazoncognito.com

# Frontend URL from the stack output FrontendURL, with a trailing slash. Must also be listed as
# an allowed callback URL and sign-out URL on the Cognito app client.
VITE_COGNITO_LOGIN_REDIRECT=https://d222222abcdef8.cloudfront.net/
VITE_COGNITO_LOGOUT_REDIRECT=https://d222222abcdef8.cloudfront.net/

# Optional: "legacy" makes the old gallery the default UI instead of the timeline.
# VITE_UI=legacy
