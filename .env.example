# ──────────────────────────────────────────────
# lawt — Configuration
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── AWS Credentials ────────────────────────────
# Use AWS CLI profile or IAM roles when possible.
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are fallbacks.
AWS_PROFILE=default
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_DEFAULT_ACCOUNT=

# ── CDK / Deployment ──────────────────────────
# The environment name used in stack names (dev/staging/prod)
CDK_ENV=dev

# Bucket to use (leave empty to create new, or specify existing)
# If the bucket already exists, set this and the CDK will reference it.
EXISTING_BUCKET_NAME=

# ── Cognito ───────────────────────────────────
# These are created by CDK. For local dev they map to localstack.
COGNITO_USER_POOL_DOMAIN=lawt-auth.local

# ── Frontend Dev ──────────────────────────────
# Vite dev server port
VITE_DEV_PORT=5173

# API base URL — set to localhost when using local mock server
# In production this points to the API Gateway endpoint
VITE_API_BASE_URL=http://localhost:3001/api

# ── Localstack (Local Development) ────────────
# Localstack service endpoints (usually http://localhost:4566)
LOCALSTACK_ENDPOINT=http://localhost:4566
LOCALSTACK_AWS_REGION=us-east-1
LOCALSTACK_AWS_ACCESS_KEY_ID=test
LOCALSTACK_AWS_SECRET_ACCESS_KEY=test

# ── Rust Lambda ───────────────────────────────
# Memory allocation for preview_generator Lambda (MB)
LAMBDA_PREVIEW_MEMORY=1024
# Timeout for Lambda functions (seconds)
LAMBDA_TIMEOUT=30
