# lawt deployment settings. Copy to lawt.env (git-ignored) and fill in.
# Read literally, like `docker run --env-file`: KEY=value per line, no quotes, no $ expansion.
# Real environment variables override this file.

# AWS account id that owns the stack.
AWS_ACCOUNT=123456789012

# Region for every resource, for example eu-west-1.
AWS_REGION=eu-west-1

# Existing S3 bucket that holds your original photos under the prefix "all images/".
# lawt only reads from it. It never writes, copies or deletes there.
PHOTO_BUCKET=my-photo-bucket

# Existing Cognito user pool and app client (authorization code grant, with a client secret).
COGNITO_USER_POOL_ID=eu-west-1_AbCdEfGhI
COGNITO_USER_POOL_CLIENT_ID=exampleclientid1234567890ab

# Hosted UI host of that pool (the domain you created under App integration).
COGNITO_DOMAIN=my-prefix.auth.eu-west-1.amazoncognito.com

# Optional. Names of the deployed resources. Defaults shown.
# Keep your old values here if you already deployed under another name,
# otherwise a deploy creates a second stack.
# APP_NAME=lawt
# STACK_NAME=LawtStack
